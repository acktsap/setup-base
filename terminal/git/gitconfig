[alias]
  st = status .
  di = diff .
  ca = diff --cached .
  lo = log --graph --abbrev-commit --decorate --format=format:'%C(cyan)%h%C(reset) - %C(green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(yellow)%d%C(reset)' --all
  # multi-line helpers below delegate to the git-helpers script (terminal/git/git-helpers, on PATH via setup.sh)
  # prune branch
  pb = "!git-helpers pb"
  # clean all local branches without current one
  cb = "!git-helpers cb"
  # switch using fuzzy finder
  ch = "!git switch $(git branch | fzf)"
  # print origin's default branch (main/master), falling back if origin/HEAD is unset
  default-branch = "!git-helpers default-branch"
  # fetch + update the local default branch, then rebase the current branch onto it
  rb = "!git-helpers rb"
  may-the-force-be-with-you = "!git-helpers may-the-force-be-with-you"
  me = "!git config user.name 'Taeik Lim' && git config user.email 'sibera21@gmail.com'"
  cm = "!git commit -s"
  # pr (usage: 'git pr 115', 'git pr 115 origin')
  pr  = "!git-helpers pr"
  pr-clean = "!git-helpers pr-clean"
  amend-force-push = "!git-helpers amend-force-push"
  # prune worktrees whose upstream branch is gone (remote deleted); removes clean worktree + its branch, skips dirty
  wt-gone = "!git-helpers wt-gone"
  # open current branch's PR in Orca IDE browser (falls back to system browser); no PR -> ask to open repo
  open-browser = "!git-helpers open-browser"

# you have to keep it manually for each repository
# git config --local user.name "${USER_NAME}"
# git config --local user.email "${USER_EMAIL}"
# eg. 
# git config --local user.name "Taeik Lim"
# git config --local user.email "sibera21@gmail.com"
[user]
  useConfigOnly = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[pull]
  ff = only

[core]
  # resolve broken hangul in git diff
  quotepath = false
  # syntax-highlighting pager (requires delta; installed by delta/setup.sh)
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  dark = true
  navigate = true
  line-numbers = true
  # Match Ghostty's IntelliJ Darcula palette; avoid delta's bright bundled theme.
  syntax-theme = ansi
  file-style = "#6897bb" bold
  hunk-header-style = syntax bold
  zero-style = syntax
  minus-style = "#cf5b56" "#432f2f"
  minus-emph-style = "#dc6a63" "#513636"
  minus-empty-line-marker-style = normal "#432f2f"
  plus-style = "#7fa461" "#344033"
  plus-emph-style = "#8db46f" "#3e4c3d"
  plus-empty-line-marker-style = normal "#344033"
  line-numbers-left-style = "#555555"
  line-numbers-right-style = "#555555"
  line-numbers-minus-style = "#cf5b56"
  line-numbers-plus-style = "#7fa461"
